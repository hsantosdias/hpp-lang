{
  "name": "hpp-lang",
  "version": "0.6.0",
  "description": "H++, a bilingual educational programming language for autonomous robotics.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "hpp",
    "programming-language",
    "dsl",
    "robotics",
    "simulation",
    "education",
    "interpreter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsantosdias/hpp-lang.git",
    "directory": "packages/hpp-lang"
  },
  "homepage": "https://github.com/hsantosdias/hpp-lang#readme",
  "bugs": {
    "url": "https://github.com/hsantosdias/hpp-lang/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
