{
  "name": "hpp-lang-monorepo",
  "version": "0.6.1",
  "private": true,
  "description": "H++, a bilingual educational programming language for autonomous robotics.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=hpp-lang",
